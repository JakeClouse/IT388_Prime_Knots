#!/bin/bash
#SBATCH --job-name=knots-17
#SBATCH --partition=compute
#SBATCH --account=YOUR_ACCOUNT
#SBATCH --nodes=8
#SBATCH --ntasks-per-node=64
#SBATCH --cpus-per-task=2
#SBATCH --mem=240G
#SBATCH --time=48:00:00
#SBATCH --output=knots-17.%j.out

# Full census of prime knots up to 17 crossings.
source scripts/env.sh
mkdir -p results
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
srun --mpi=pmi2 build/census 17 --csv results/census17.csv
