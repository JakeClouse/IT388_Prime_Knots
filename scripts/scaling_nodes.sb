#!/bin/bash
#SBATCH --job-name=knots-nodes
#SBATCH --partition=compute
#SBATCH --account=YOUR_ACCOUNT
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=64
#SBATCH --cpus-per-task=2
#SBATCH --mem=240G
#SBATCH --time=04:00:00
#SBATCH --output=knots-nodes.%j.out

# Submit once per node count:
#   for n in 1 2 4 8; do sbatch --nodes=$n scripts/scaling_nodes.sb; done
source scripts/env.sh
mkdir -p results
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
srun --mpi=pmi2 build/census ${N:-14} --csv results/scaling_nodes.csv
